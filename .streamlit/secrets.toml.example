# ----------------------------------------------------------------------------
# Streamlit Community Cloud secrets template for DocuQuery AI.
#
# DO NOT commit a real secrets.toml. On Streamlit Cloud, paste these values in:
#   App  ->  Settings  ->  Secrets
# Locally you may copy this file to `.streamlit/secrets.toml` (git-ignored) to
# test the Cloud path, but prefer a plain `.env` + real AWS profile locally.
#
# SECURITY: the repo is PUBLIC. Use a DEDICATED, least-privilege IAM user for
# these keys (see docs/iam-cloud-user-policy.json), NOT an admin user. Rotate
# the keys periodically and delete them when the demo is over.
# ----------------------------------------------------------------------------

AWS_REGION = "us-east-1"
AWS_ACCESS_KEY_ID = "AKIA_REPLACE_ME"
AWS_SECRET_ACCESS_KEY = "REPLACE_ME"

DOCUQUERY_BUCKET = "docuquery-ai-study-466742534146-us-east-1"
DOCUQUERY_PREFIX = "study-docs/"
BEDROCK_MODEL_ID = "amazon.nova-pro-v1:0"

DOCUQUERY_MAX_MB = "10"
DOCUQUERY_MAX_CHARS = "12000"
