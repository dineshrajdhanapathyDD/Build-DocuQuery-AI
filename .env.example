# ----------------------------------------------------------------------------
# DocuQuery AI - example environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# No secrets are stored in this file; credentials come from the standard AWS
# credential provider chain (env vars, shared config, IAM role, SSO, etc.).
# ----------------------------------------------------------------------------

# AWS region used for both Amazon S3 and Amazon Bedrock calls.
AWS_REGION=us-east-1

# The single S3 bucket the agent is allowed to read documents from.
# The model can NEVER choose a different bucket - this value is fixed here.
DOCUQUERY_BUCKET=my-docuquery-study-bucket

# Optional key prefix (folder) inside the bucket that documents live under.
# Only object keys starting with this prefix are selectable. Leave blank for
# the whole bucket.
DOCUQUERY_PREFIX=study-docs/

# Bedrock model id used by the agent.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# Maximum object size (in megabytes) the S3 tool will download/process.
# 50 MB is a safe ceiling for Streamlit Community Cloud's free-tier memory.
DOCUQUERY_MAX_MB=50

# Maximum number of characters of extracted text returned to the model.
DOCUQUERY_MAX_CHARS=12000

# ----------------------------------------------------------------------------
# AWS credentials (OPTIONAL here - prefer an IAM role or `aws configure`).
# These are shown only to document the provider chain. Leave them unset and
# use a role/profile whenever possible. Do NOT paste long-lived keys into a
# committed file.
# ----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=default
