{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadStudyDocumentsPrefixOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_YOUR_BUCKET/study-docs/*"
    },
    {
      "Sid": "ListOnlyStudyPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_YOUR_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "study-docs/*"
          ]
        }
      }
    },
    {
      "Sid": "InvokeBedrockModel",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": "arn:aws:bedrock:*::foundation-model/*"
    }
  ]
}
